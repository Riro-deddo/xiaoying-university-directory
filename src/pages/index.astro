---
import '../styles/global.css';
import { loadInstitutions, loadRequirements, loadUniversities } from '../lib/data';
import { buildOfficialListDisplays } from '../lib/official-list-display';
import { serializeJsonForHtml } from '../lib/html-json';
import {
  directoryFilters,
  directoryRankCopy,
  institutionRuleTypeCopy,
  officialPanelTitle,
  sourceFreshnessCopy,
  sourceHealthCopy,
  stateCopy,
} from '../lib/presentation';
import { withBase } from '../lib/urls';

const institutions = loadInstitutions();
const universities = loadUniversities();
const requirements = loadRequirements();
const officialListsByUniversity = buildOfficialListDisplays({ universities, institutions, requirements });
const base = import.meta.env.BASE_URL;
const officialListPanelsByUniversity = new Map(
  [...officialListsByUniversity.entries()].map(([universityId, panels]) => [
    universityId,
    panels.map(({ rows, ...panel }) => ({
      ...panel,
      recordCount: rows.length,
      dataUrl: withBase(base, `generated/lists/${panel.sourceId}.json`),
    })),
  ]),
);
const searchData = { institutions, universities, reverseIndexUrl: withBase(base, 'generated/reverse-index.json') };
const searchDataJson = serializeJsonForHtml(searchData);
const homeUrl = withBase(base, '');
const methodologyUrl = withBase(base, 'methodology/');
const faviconUrl = withBase(base, 'favicon.svg');
const correctionUrl = 'https://github.com/Riro-deddo/xiaoying-university-directory/issues/new';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="集中查找英国大学面向中国本科背景发布的院校准入、成绩分档与申请要求。" />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <title>小英高校百科｜英国大学中国院校规则导航</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={homeUrl}>小英高校百科</a>
      <a class="method-link" href={methodologyUrl}>数据方法</a>
    </header>

    <main>
      <section class="intro" aria-labelledby="page-title">
        <h1 id="page-title">英国大学中国院校规则，一页查清</h1>
        <p>分清院校准入限制、成绩门槛分档与普通中国申请要求。</p>
        <p class="directory-scope">28 所 QS 2027 世界前 200 英国大学 + 1 所专业院校</p>

        <div class="search-modes" role="group" aria-label="搜索方向">
          <button class="search-mode active" type="button" data-search-mode="uk-university" aria-pressed="true">查英国大学</button>
          <button class="search-mode" type="button" data-search-mode="chinese-institution" aria-pressed="false">查中国本科院校</button>
        </div>

        <label class="search-box">
          <span id="search-label" class="sr-only">搜索英国大学</span>
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="m16 16 5 5"></path></svg>
          <input id="university-search" type="search" placeholder="搜索大学中文名、英文名或简称" autocomplete="off" aria-describedby="search-help" />
        </label>
        <p id="search-help" class="search-help">按大学中文名、英文名或简称搜索，并可按公开信息状态筛选。</p>

        <div id="directory-filters" class="filters" aria-label="按公开信息状态筛选">
          {directoryFilters.map(([value, label]) => (
            <button class:list={['filter', { active: value === 'all' }]} type="button" data-state={value} aria-pressed={value === 'all'}>{label}</button>
          ))}
        </div>
      </section>

      <section id="uk-directory" class="directory" aria-labelledby="result-count">
        <p id="result-count" class="result-count" aria-live="polite">共 {universities.length} 所大学</p>
        <div class="list-head" aria-hidden="true">
          <span>大学</span><span>QS 2027 排名</span><span>公开状态</span><span>内容范围</span><span>官方来源与操作</span>
        </div>
        <div id="university-list" class="university-list">
          {universities.map((university) => (
            <article class="university-row" data-id={university.id}>
              <div class="university-name">
                <h2>{university.nameZh}</h2>
                <p>{university.nameEn}</p>
              </div>
              <div class="rank"><span class="mobile-label">{university.directoryCategory === 'specialist' ? '目录类别' : 'QS 2027'}</span>{directoryRankCopy(university)}</div>
              <div class="state">
                <span class:list={['status-dot', `status-${university.state}`]}></span>
                <span title={stateCopy[university.state].description}>{stateCopy[university.state].label}</span>
              </div>
              <div class="scope">
                {university.sources.length > 0
                  ? university.sources.map((source) => <span>{source.scopeZh ?? source.labelZh}</span>)
                  : <span>{university.noteZh}</span>}
              </div>
              <div class="university-rule-summary">
                {university.state === 'china-requirements' && <strong>本科院校会影响要求，完整名单未公开。</strong>}
                {university.sources.map((source) => (
                  <p>
                    <span>{source.scopeZh}：</span>{source.institutionRule.summaryZh}
                    {source.parser.mode === 'link-only' && source.institutionRule.type !== 'none' && ' 官网存在院校规则，但本站暂未完成安全结构化，暂不附表。'}
                  </p>
                ))}
              </div>
              <div class="source-actions">
                {university.sources.length > 0
                  ? university.sources.map((source) => (
                      <a href={source.url} target="_blank" rel="noopener noreferrer">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M14 4h6v6M20 4l-9 9"></path><path d="M19 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h6"></path></svg>
                        <span>{source.labelZh}</span>
                        <small class="rule-type">{institutionRuleTypeCopy[source.institutionRule.type].label}</small>
                        <small>{sourceHealthCopy[source.status?.health ?? 'unchecked']} · {sourceFreshnessCopy(source.status)}</small>
                      </a>
                    ))
                  : <span class="no-source">尚无已核验的公开入口</span>}
              </div>
              {(officialListPanelsByUniversity.get(university.id) ?? []).map((panel) => (
                <details class="official-list-panel" data-list-url={panel.dataUrl} data-source-id={panel.sourceId} data-list-state="pending">
                  <summary>{officialPanelTitle(panel.ruleType, panel.recordCount)}</summary>
                  <div class="official-rule-meaning">
                    <strong>{panel.ruleSummaryZh}</strong>
                    <p><span>名单内：</span>{panel.listedMeaningZh}</p>
                    <p><span>名单外：</span>{panel.unlistedMeaningZh}</p>
                    {panel.caveatZh && <p>{panel.caveatZh}</p>}
                    {panel.scope !== 'university' && <p class="scope-warning">仅适用于：{panel.scopeZh}</p>}
                  </div>
                  <div class="official-list-meta">
                    <span>{panel.sourceLabelZh}</span>
                    <span>适用范围：{panel.scopeZh}</span>
                    {panel.cycle && <span>申请季：{panel.cycle}</span>}
                    <span>最近提取：{panel.extractedAt.slice(0, 10)}</span>
                    <span>规则人工核验：{panel.ruleReviewedAt}</span>
                    <a href={panel.sourceUrl} target="_blank" rel="noopener noreferrer">查看大学官网原页</a>
                    <a href={panel.ruleSourceUrl} target="_blank" rel="noopener noreferrer">查看规则说明来源</a>
                  </div>
                  <ol class="official-list-rows" hidden></ol>
                  <p class="list-load-message" aria-live="polite" hidden></p>
                  <button class="list-retry" type="button" hidden>重新加载名单</button>
                </details>
              ))}
            </article>
          ))}
        </div>
        <div id="empty-state" class="empty-state" hidden>
          <h2>暂时没有匹配结果</h2>
          <p>可以尝试英文名或简称；具体要求请以大学官网及招生部门答复为准。</p>
        </div>
      </section>

      <section id="institution-results" class="institution-results" aria-labelledby="institution-result-count" hidden>
        <p id="institution-result-count" class="result-count" aria-live="polite">输入中国本科院校名称开始查询</p>
        <div id="institution-chooser" class="institution-chooser" aria-live="polite"></div>
        <div id="institution-evidence" class="institution-evidence"></div>
      </section>
    </main>

    <footer>
      <nav aria-label="页脚导航"><a href={methodologyUrl}>数据方法</a><a href={correctionUrl} target="_blank" rel="noopener noreferrer">提交纠错</a></nav>
      <p>本站仅作官方信息导航，最终要求以大学官网及招生部门答复为准。</p>
    </footer>

    <script is:inline id="directory-data" type="application/json" set:html={searchDataJson}></script>
    <script>
      import { createInstitutionEvidenceSearch, createUniversitySearch } from '../lib/search';
      import { directoryRankCopy, evidenceCopyFor, sourceFreshnessCopy } from '../lib/presentation';
      import type { UniversityState, UniversityWithStatus } from '../lib/types';

      const dataNode = document.querySelector<HTMLScriptElement>('#directory-data');
      const data = JSON.parse(dataNode?.textContent ?? '{}') as {
        institutions: Parameters<typeof createInstitutionEvidenceSearch>[0]['institutions'];
        universities: UniversityWithStatus[];
        reverseIndexUrl: string;
      };
      const directory = createUniversitySearch(data.universities ?? []);
      let institutionDirectory: ReturnType<typeof createInstitutionEvidenceSearch> | undefined;
      let reverseIndexLoading: Promise<void> | undefined;
      let reverseIndexMessage = '';
      const input = document.querySelector<HTMLInputElement>('#university-search');
      const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
      const modeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-search-mode]')];
      const rows = [...document.querySelectorAll<HTMLElement>('.university-row')];
      const count = document.querySelector<HTMLElement>('#result-count');
      const empty = document.querySelector<HTMLElement>('#empty-state');
      const label = document.querySelector<HTMLElement>('#search-label');
      const help = document.querySelector<HTMLElement>('#search-help');
      const filters = document.querySelector<HTMLElement>('#directory-filters');
      const ukDirectory = document.querySelector<HTMLElement>('#uk-directory');
      const institutionResults = document.querySelector<HTMLElement>('#institution-results');
      const institutionCount = document.querySelector<HTMLElement>('#institution-result-count');
      const chooser = document.querySelector<HTMLElement>('#institution-chooser');
      const evidence = document.querySelector<HTMLElement>('#institution-evidence');
      let selected: UniversityState[] = [];
      let mode: 'uk-university' | 'chinese-institution' = 'uk-university';

      async function loadInstitutionDirectory() {
        if (institutionDirectory || reverseIndexLoading) return reverseIndexLoading;
        reverseIndexMessage = '正在加载中国院校索引…';
        reverseIndexLoading = fetch(data.reverseIndexUrl, { cache: 'force-cache' })
          .then(async (response) => {
            if (!response.ok) throw new Error(`Reverse index request failed: ${response.status}`);
            const reverseIndex = await response.json();
            if (!Array.isArray(reverseIndex)) throw new Error('Reverse index payload is invalid');
            institutionDirectory = createInstitutionEvidenceSearch({
              institutions: data.institutions ?? [], universities: data.universities ?? [], reverseIndex,
            });
            reverseIndexMessage = '';
          })
          .catch(() => {
            reverseIndexMessage = '中国院校索引暂时无法加载，请稍后重试。';
            institutionDirectory = undefined;
          })
          .finally(() => { reverseIndexLoading = undefined; update(); });
        return reverseIndexLoading;
      }

      function updateUniversityDirectory() {
        const matches = directory.search(input?.value ?? '', selected);
        const visible = new Set(matches.map((item) => item.id));
        rows.forEach((row) => { row.hidden = !visible.has(row.dataset.id ?? ''); });
        if (count) count.textContent = `共 ${matches.length} 所大学`;
        if (empty) empty.hidden = matches.length !== 0;
      }

      function makeElement<K extends keyof HTMLElementTagNameMap>(tag: K, text?: string): HTMLElementTagNameMap[K] {
        const element = document.createElement(tag);
        if (text) element.textContent = text;
        return element;
      }

      function evidenceField(labelText: string, value: string) {
        const row = makeElement('div');
        const fieldLabel = makeElement('dt', labelText);
        const fieldValue = makeElement('dd', value);
        row.append(fieldLabel, fieldValue);
        return row;
      }

      function renderInstitutionResult() {
        if (!institutionDirectory) {
          chooser?.replaceChildren();
          evidence?.replaceChildren();
          if (institutionCount) institutionCount.textContent = reverseIndexMessage || '正在加载中国院校索引…';
          return;
        }
        const result = institutionDirectory.search(input?.value ?? '');
        chooser?.replaceChildren();
        evidence?.replaceChildren();
        if (result.kind === 'empty') {
          if (institutionCount) institutionCount.textContent = '输入中国本科院校名称开始查询';
          return;
        }
        if (result.kind === 'unknown') {
          if (institutionCount) institutionCount.textContent = '未找到匹配的中国本科院校';
          return;
        }
        if (result.kind === 'suggestions') {
          if (institutionCount) institutionCount.textContent = `找到 ${result.suggestions.length} 个可能的院校，请选择一个规范名称`;
          const title = makeElement('p', '请选择规范院校名称后查看 28 所英国大学的公开信息：');
          chooser?.append(title);
          result.suggestions.forEach((institution) => {
            const button = makeElement('button', `${institution.nameZh}｜${institution.nameEn}`);
            button.type = 'button';
            button.className = 'institution-choice';
            button.dataset.institutionId = institution.id;
            chooser?.append(button);
          });
          return;
        }

        if (institutionCount) institutionCount.textContent = `${result.institution.nameZh}：${result.cards.length} 所英国大学的公开信息`;
        const heading = makeElement('h2', `${result.institution.nameZh}｜${result.institution.nameEn}`);
        evidence?.append(heading);
        result.cards.forEach((card) => {
          const copy = evidenceCopyFor(card.evidence);
          const article = makeElement('article');
          article.className = 'evidence-card';
          const title = makeElement('h3', `${card.university.nameZh}｜${directoryRankCopy(card.university)}`);
          const status = makeElement('p', copy.label);
          status.className = 'evidence-state';
          const description = makeElement('p', copy.description);
          const fields = makeElement('dl');
          if (card.evidence.tierOfficial) fields.append(evidenceField('官方分组/等级', card.evidence.tierOfficial));
          if (card.evidence.scoreOfficial) fields.append(evidenceField('官方分数', card.evidence.scoreOfficial));
          if (card.evidence.scopeZh) fields.append(evidenceField('适用范围', card.evidence.scopeZh));
          if (card.evidence.cycle) fields.append(evidenceField('周期', card.evidence.cycle));
          if (card.ruleReviewedAt) fields.append(evidenceField('规则人工核验', card.ruleReviewedAt));
          fields.append(evidenceField('最近成功检查', sourceFreshnessCopy({ sourceId: card.evidence.sourceId ?? '', health: 'unchecked', lastSuccessfulAt: card.evidence.lastSuccessfulAt })));
          article.append(title, status, description, fields);
          if (card.sourceUrl) {
            const link = makeElement('a', `官方来源：${card.sourceLabelZh ?? '查看来源'}`);
            link.href = card.sourceUrl;
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            article.append(link);
          }
          if (card.ruleSourceUrl && card.ruleSourceUrl !== card.sourceUrl) {
            const ruleLink = makeElement('a', '查看规则说明来源');
            ruleLink.href = card.ruleSourceUrl;
            ruleLink.target = '_blank';
            ruleLink.rel = 'noopener noreferrer';
            article.append(ruleLink);
          }
          evidence?.append(article);
        });
      }

      function update() {
        if (mode === 'uk-university') updateUniversityDirectory();
        else renderInstitutionResult();
      }

      function setMode(nextMode: 'uk-university' | 'chinese-institution') {
        mode = nextMode;
        const chineseMode = mode === 'chinese-institution';
        modeButtons.forEach((button) => {
          const active = button.dataset.searchMode === mode;
          button.classList.toggle('active', active);
          button.setAttribute('aria-pressed', String(active));
        });
        if (label) label.textContent = chineseMode ? '搜索中国本科院校' : '搜索英国大学';
        if (input) input.placeholder = chineseMode ? '搜索中国本科院校中文名、英文名或别名' : '搜索大学中文名、英文名或简称';
        if (help) help.textContent = chineseMode ? '精确匹配会显示 28 所英国大学的公开信息；模糊结果仅供选择规范名称。' : '按大学中文名、英文名或简称搜索，并可按公开信息状态筛选。';
        if (filters) filters.hidden = chineseMode;
        if (ukDirectory) ukDirectory.hidden = chineseMode;
        if (institutionResults) institutionResults.hidden = !chineseMode;
        if (input) input.value = '';
        if (chineseMode) void loadInstitutionDirectory();
        update();
      }

      input?.addEventListener('input', update);
      buttons.forEach((button) => button.addEventListener('click', () => {
        const value = button.dataset.state;
        buttons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        selected = value && value !== 'all' ? [value as UniversityState] : [];
        updateUniversityDirectory();
      }));
      modeButtons.forEach((button) => button.addEventListener('click', () => {
        const nextMode = button.dataset.searchMode;
        if (nextMode === 'uk-university' || nextMode === 'chinese-institution') setMode(nextMode);
      }));
      chooser?.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-institution-id]');
        const institutionId = button?.dataset.institutionId;
        const currentInstitutionDirectory = institutionDirectory;
        if (!institutionId || !evidence || !institutionCount || !currentInstitutionDirectory) return;
        const result = currentInstitutionDirectory.select(institutionId);
        if (result.kind !== 'selected') return;
        if (input) input.value = result.institution.nameZh;
        renderInstitutionResult();
      });

      function listValue(labelText: string, value: string) {
        const wrapper = makeElement('span');
        wrapper.className = 'official-list-value';
        wrapper.append(makeElement('small', labelText), document.createTextNode(value));
        return wrapper;
      }

      function renderOfficialListRows(rows: Array<{ nameZh: string; nameEn: string; tierOfficial: string; scoreOfficial?: string }>, target: HTMLOListElement) {
        target.replaceChildren(...rows.map((row) => {
          const item = makeElement('li');
          const name = makeElement('span');
          name.className = 'official-list-name';
          name.append(makeElement('strong', row.nameZh), makeElement('small', row.nameEn));
          item.append(name, listValue('官方分组/等级', row.tierOfficial));
          if (row.scoreOfficial) item.append(listValue('官方分数', row.scoreOfficial));
          return item;
        }));
        target.hidden = false;
      }

      async function loadOfficialList(panel: HTMLDetailsElement) {
        if (panel.dataset.listState === 'complete' || panel.dataset.listState === 'loading') return;
        const message = panel.querySelector<HTMLElement>('.list-load-message');
        const retry = panel.querySelector<HTMLButtonElement>('.list-retry');
        const rowsTarget = panel.querySelector<HTMLOListElement>('.official-list-rows');
        if (!message || !retry || !rowsTarget || !panel.dataset.listUrl) return;
        panel.dataset.listState = 'loading';
        message.hidden = false;
        message.textContent = '正在加载已核验的官方名单…';
        retry.hidden = true;
        try {
          const response = await fetch(panel.dataset.listUrl, { cache: 'force-cache' });
          if (!response.ok) throw new Error(`List request failed: ${response.status}`);
          const payload = await response.json() as { sourceId?: string; rows?: Array<{ nameZh?: string; nameEn?: string; tierOfficial?: string; scoreOfficial?: string }> };
          if (payload.sourceId !== panel.dataset.sourceId || !Array.isArray(payload.rows) || payload.rows.length === 0
            || payload.rows.some((row) => !row.nameZh || !row.nameEn || !row.tierOfficial)) throw new Error('List payload is invalid');
          renderOfficialListRows(payload.rows as Array<{ nameZh: string; nameEn: string; tierOfficial: string; scoreOfficial?: string }>, rowsTarget);
          panel.dataset.listState = 'complete';
          message.hidden = true;
        } catch {
          panel.dataset.listState = 'failed';
          message.textContent = '名单暂时无法加载；请稍后重试，或直接查看大学官网原页。';
          retry.hidden = false;
        }
      }

      document.querySelectorAll<HTMLDetailsElement>('.official-list-panel').forEach((panel) => {
        panel.addEventListener('toggle', () => { if (panel.open) void loadOfficialList(panel); });
        panel.querySelector<HTMLButtonElement>('.list-retry')?.addEventListener('click', () => void loadOfficialList(panel));
      });
    </script>
  </body>
</html>
