---
type IconName = 'alert-triangle' | 'chevron-down' | 'external-link' | 'search';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class:list={['ui-icon', `ui-icon--${name}`, className]}
  data-ui-icon={name}
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 24 24"
>
  {name === 'search' && (
    <>
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m16 16 5 5"></path>
    </>
  )}
  {name === 'external-link' && (
    <>
      <path d="M14 4h6v6M20 4l-9 9"></path>
      <path d="M19 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h6"></path>
    </>
  )}
  {name === 'chevron-down' && <path d="m6 9 6 6 6-6"></path>}
  {name === 'alert-triangle' && (
    <>
      <path d="M10.3 4.3 2.6 18a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0Z"></path>
      <path d="M12 9v4"></path>
      <path d="M12 17h.01"></path>
    </>
  )}
</svg>
