{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["universityId", "entryState", "reviewedAt", "links"],
    "properties": {
      "universityId": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
      "entryState": { "enum": ["available", "no-public-entry"] },
      "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "links": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "universityId",
            "labelZh",
            "scopeZh",
            "kind",
            "requiresFiltering",
            "url",
            "pageTitle",
            "reviewedAt",
            "requiredText",
            "monitorMode"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1, "pattern": "^scholarships-[a-z0-9-]+$" },
            "universityId": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
            "labelZh": { "const": "查看硕士奖学金官网" },
            "scopeZh": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["masters-directory", "masters-search", "postgraduate-funding", "category"] },
            "requiresFiltering": { "type": "boolean" },
            "url": { "type": "string", "minLength": 1, "pattern": "^https://" },
            "pageTitle": { "type": "string", "minLength": 1 },
            "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "requiredText": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "monitorMode": { "const": "page-identity" }
          },
          "if": {
            "properties": { "kind": { "const": "postgraduate-funding" } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "requiresFiltering": { "const": true } }
          }
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": { "entryState": { "const": "available" } },
          "required": ["entryState"]
        },
        "then": {
          "properties": { "links": { "type": "array", "minItems": 1, "maxItems": 3 } }
        },
        "else": {
          "properties": { "links": { "type": "array", "maxItems": 0 } }
        }
      }
    ]
  }
}
