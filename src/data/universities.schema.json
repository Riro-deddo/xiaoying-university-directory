{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "nameZh", "nameEn", "aliases", "directoryCategory", "state", "officialDomain", "sourceIds"],
    "properties": {
      "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
      "nameZh": { "type": "string", "minLength": 1 },
      "nameEn": { "type": "string", "minLength": 1 },
      "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
      "directoryCategory": { "enum": ["qs-directory", "specialist"] },
      "qsDirectory": {
        "type": "object",
        "additionalProperties": false,
        "required": ["firstEdition", "verifiedEdition", "current"],
        "properties": {
          "firstEdition": { "type": "integer", "minimum": 1 },
          "verifiedEdition": { "type": "integer", "minimum": 1 },
          "current": { "type": "boolean" }
        }
      },
      "strengthEvidence": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "provider", "rankingName", "subjectZh", "edition", "placement", "displayRank", "sourceUrl", "noteZh"],
        "properties": {
          "kind": { "enum": ["subject-ranking", "research-assessment"] },
          "provider": { "enum": ["qs", "shanghai", "ref"] },
          "rankingName": { "type": "string", "minLength": 1 },
          "subjectZh": { "type": "string", "minLength": 1 },
          "edition": { "type": "integer", "minimum": 1 },
          "placement": { "enum": ["exact", "band", "derived-national-exact"] },
          "displayRank": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": "string", "pattern": "^https://" },
          "noteZh": { "type": "string", "minLength": 1 }
        }
      },
      "state": { "enum": ["official-list", "china-requirements", "faculty-only", "not-public", "pending"] },
      "officialDomain": { "type": "string", "pattern": "^https://" },
      "sourceIds": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true },
      "noteZh": { "type": "string", "minLength": 1 }
    },
    "allOf": [
      {
        "if": { "properties": { "directoryCategory": { "const": "qs-directory" } }, "required": ["directoryCategory"] },
        "then": { "required": ["qsDirectory"] },
        "else": { "not": { "required": ["qsDirectory"] } }
      }
    ]
  }
}
