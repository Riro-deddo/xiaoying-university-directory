{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "nameZh", "nameEn", "aliases", "directoryCategory", "state", "officialDomain", "sourceIds"],
    "properties": {
      "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
      "nameZh": { "type": "string", "minLength": 1 },
      "nameEn": { "type": "string", "minLength": 1 },
      "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
      "directoryCategory": { "enum": ["qs-top-200", "specialist"] },
      "qs": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edition", "rank"],
        "properties": {
          "edition": { "const": 2027 },
          "rank": { "type": "integer", "minimum": 1, "maximum": 200 }
        }
      },
      "state": { "enum": ["official-list", "china-requirements", "faculty-only", "not-public", "pending"] },
      "officialDomain": { "type": "string", "pattern": "^https://" },
      "sourceIds": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" }, "uniqueItems": true },
      "noteZh": { "type": "string", "minLength": 1 }
    },
    "allOf": [
      {
        "if": { "properties": { "directoryCategory": { "const": "qs-top-200" } }, "required": ["directoryCategory"] },
        "then": { "required": ["qs"] },
        "else": { "not": { "required": ["qs"] } }
      }
    ]
  }
}
