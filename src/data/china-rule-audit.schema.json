{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["universityId", "directoryCategory", "expectedState", "reviewDate", "finding"],
    "properties": {
      "universityId": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
      "directoryCategory": { "enum": ["qs-top-200", "specialist"] },
      "expectedState": { "enum": ["official-list", "china-requirements", "faculty-only", "not-public", "pending"] },
      "reviewDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "finding": { "type": "string", "minLength": 1, "pattern": "\\S" }
    }
  }
}
