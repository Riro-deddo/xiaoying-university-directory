{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "universityId",
      "labelZh",
      "url",
      "pageTitle",
      "reviewedAt",
      "requiredText",
      "monitorMode"
    ],
    "properties": {
      "id": { "type": "string", "minLength": 1, "pattern": "^masters-[a-z0-9-]+$" },
      "universityId": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
      "labelZh": { "const": "查看全部硕士课程" },
      "url": { "type": "string", "minLength": 1, "pattern": "^https://" },
      "pageTitle": { "type": "string", "minLength": 1 },
      "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "requiredText": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      },
      "monitorMode": { "const": "page-identity" }
    }
  }
}
