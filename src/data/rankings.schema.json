{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["releases", "records"],
  "properties": {
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "rankingName", "edition", "country", "sourceUrl", "attribution", "verifiedAt"],
        "properties": {
          "provider": { "enum": ["qs", "the"] },
          "rankingName": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "edition": { "type": "integer", "minimum": 1 },
          "country": { "const": "United Kingdom" },
          "sourceUrl": { "type": "string", "pattern": "^https://" },
          "attribution": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "verifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["universityId", "provider", "edition", "placement"],
        "properties": {
          "universityId": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
          "provider": { "enum": ["qs", "the"] },
          "edition": { "type": "integer", "minimum": 1 },
          "placement": { "enum": ["exact", "tied", "band", "unranked", "unverified"] },
          "displayRank": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "sortRank": { "type": "integer", "minimum": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "placement": { "enum": ["exact", "tied", "band"] } }, "required": ["placement"] },
            "then": { "required": ["displayRank", "sortRank"] }
          },
          {
            "if": { "properties": { "placement": { "enum": ["unranked", "unverified"] } }, "required": ["placement"] },
            "then": { "not": { "anyOf": [{ "required": ["displayRank"] }, { "required": ["sortRank"] }] } }
          }
        ]
      }
    }
  }
}
